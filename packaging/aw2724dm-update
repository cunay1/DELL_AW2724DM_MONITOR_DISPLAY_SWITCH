#!/usr/bin/env bash
set -Eeuo pipefail

REPOSITORY="cunay1/DELL_AW2724DM_MONITOR_DISPLAY_SWITCH"
PUBLIC_KEY="/opt/aw2724dm-control/release-public-key.pem"

progress() {
    printf 'AW2724DM_PROGRESS:%s:%s\n' "$1" "$2"
}

if [[ ${EUID} -ne 0 ]]; then
    echo "Bu yardımcı pkexec üzerinden root olarak çalıştırılmalıdır." >&2
    exit 1
fi

VERSION="${1:-}"
if [[ ! ${VERSION} =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "Geçersiz veya eksik sürüm numarası." >&2
    exit 2
fi
if [[ ! -f ${PUBLIC_KEY} || -L ${PUBLIC_KEY} ]]; then
    echo "Güncelleme doğrulama açık anahtarı bulunamadı veya güvenli değil." >&2
    exit 1
fi

CALLING_UID="${PKEXEC_UID:-}"
if [[ -z ${CALLING_UID} || ! ${CALLING_UID} =~ ^[0-9]+$ ]]; then
    echo "Güncellemeyi başlatan kullanıcı belirlenemedi." >&2
    exit 1
fi

CALLING_USER="$(getent passwd "${CALLING_UID}" | cut -d: -f1)"
if [[ -z ${CALLING_USER} || ${CALLING_USER} == root ]]; then
    echo "Geçerli bir masaüstü kullanıcısı belirlenemedi." >&2
    exit 1
fi

UPDATE_DIR="$(mktemp -d /tmp/aw2724dm-update.XXXXXXXX)"
cleanup() {
    rm -rf -- "${UPDATE_DIR}"
}
trap cleanup EXIT

ASSET_NAME="aw2724dm-control-${VERSION}.tar.gz"
DOWNLOAD_BASE="https://github.com/${REPOSITORY}/releases/download/v${VERSION}"
ARCHIVE="${UPDATE_DIR}/${ASSET_NAME}"
CHECKSUM="${ARCHIVE}.sha256"
SIGNATURE="${ARCHIVE}.sig"

download_progress=10
for suffix in '' '.sha256' '.sig'; do
    progress "${download_progress}" download
    curl --fail --location --proto '=https' --tlsv1.2 --silent --show-error \
        "${DOWNLOAD_BASE}/${ASSET_NAME}${suffix}" --output "${ARCHIVE}${suffix}"
    download_progress=$((download_progress + 8))
done

progress 35 verify
if [[ $(wc -l < "${CHECKSUM}") -ne 1 ]] || ! grep -Eq "^[0-9a-fA-F]{64}  ${ASSET_NAME}$" "${CHECKSUM}"; then
    echo "Güncelleme SHA-256 dosyası geçersiz." >&2
    exit 1
fi
(cd "${UPDATE_DIR}" && sha256sum --check --strict "${ASSET_NAME}.sha256")
if ! openssl pkeyutl -verify -pubin -inkey "${PUBLIC_KEY}" -rawin \
    -in "${ARCHIVE}" -sigfile "${SIGNATURE}" >/dev/null; then
    echo "Güncellemenin Ed25519 imzası doğrulanamadı; kurulum iptal edildi." >&2
    exit 1
fi

while IFS= read -r member; do
    if [[ ${member} == /* || ${member} == ../* || ${member} == *'/../'* ]]; then
        echo "Güvensiz arşiv yolu reddedildi: ${member}" >&2
        exit 1
    fi
done < <(tar -tzf "${ARCHIVE}")

progress 50 extract
tar -xzf "${ARCHIVE}" --no-same-owner --no-same-permissions -C "${UPDATE_DIR}"
SOURCE_DIR="${UPDATE_DIR}/aw2724dm-control-${VERSION}"
if [[ ! -x ${SOURCE_DIR}/install.sh || ! -f ${SOURCE_DIR}/pyproject.toml ]]; then
    echo "İndirilen güncelleme beklenen proje yapısına sahip değil." >&2
    exit 1
fi

export SUDO_USER="${CALLING_USER}"
export USER="${CALLING_USER}"
progress 65 install
bash "${SOURCE_DIR}/install.sh"
progress 98 finish
echo "Güncelleme başarıyla uygulandı."
